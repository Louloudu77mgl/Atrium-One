NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=https://atrium-one-self.vercel.app
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_DEMO_MODE=true
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
ATRIUMONE_ADMIN_EMAILS=admin@atriumone.fr
CRON_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://atrium-one-self.vercel.app/api/google/callback
GMAIL_REDIRECT_URI=https://atrium-one-self.vercel.app/api/gmail/callback
# Optionnel : utilisez un client OAuth distinct pour le Gmail administrateur du CRM.
# Si les deux premières valeurs restent vides, GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET sont réutilisés.
CRM_GMAIL_CLIENT_ID=
CRM_GMAIL_CLIENT_SECRET=
CRM_GMAIL_REDIRECT_URI=https://atrium-one-self.vercel.app/api/crm/gmail/callback
# Recommandé. À défaut, SUPABASE_SERVICE_ROLE_KEY dérive la clé de chiffrement des tokens CRM.
CRM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://atrium-one-self.vercel.app/api/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v23.0
NEXT_PUBLIC_CSM_BOOKING_URL=
GOOGLE_PLACES_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
